import numpy as np

def predict(fit, data, sweep=100):

    n = len(data)
    y_new = np.random.choice([0, 1], size=n, replace=True)
    neighbor_matrix = np.zeros((n, n))

    # Extract coefficients
    coef_est = fit.summary()["mean"].values
    P = data.shape[1] - 2
    beta = coef_est[0:P]
    eta = coef_est[P]

    for s in range(sweep):
        for i in range(n):
            for j in range(n):
                if (
                    j != i
                    and np.sqrt(
                        (
                            data.iloc[i, data.shape[1] - 2]
                            - data.iloc[j, data.shape[1] - 2]
                        ) ** 2
                        +
                        (
                            data.iloc[i, data.shape[1] - 1]
                            - data.iloc[j, data.shape[1] - 1]
                        ) ** 2
                    ) <= 1
                ):
                    neighbor_matrix[i, j] = eta * y_new[j]
                else:
                    neighbor_matrix[i, j] = 0

            logit_p = (
                np.sum(beta * data.iloc[i, 0:P])
                + np.sum(neighbor_matrix[i, :])
            )

            p = 1 / (1 + np.exp(-logit_p))

            y_new[i] = np.random.binomial(1, p)

    return y_new
